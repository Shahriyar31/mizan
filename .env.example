# ═══════════════════════════════════════════════════════════════
# Mizan Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to Git
# ═══════════════════════════════════════════════════════════════

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Scholar AI — Groq (free tier). Local Ibn Kathir JSON is used until this is wired.
GROQ_API_KEY=your_groq_key_here

# Azure OpenAI (optional / future)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your_key_here
AZURE_SEARCH_INDEX_NAME=mizan-knowledge-base

# Sunnah.com API
SUNNAH_API_KEY=your_key_here

# UmmahAPI — Quran audio, word-by-word, tafsir, mutashabihat, hadith.
# Optional: every endpoint answers without a key, but a key lifts the rate
# limit from 5,000/15min to unlimited. Register free at ummahapi.com/register.
# Sent as the X-API-Key header, never in the query string.
UMMAH_API_KEY=umh_your_key_here

# Firebase
FIREBASE_PROJECT_ID=your_project_id

# Feature Flags (1=enabled, 0=disabled)
# Enable features only when implementation is complete
FEATURE_SCHOLAR_AI=0
FEATURE_HALAQA=0
FEATURE_MINBAR=0
FEATURE_MULTILINGUAL=0
# Seed a sample Halaqa circle + Minbar feed on first run (demo only)
FEATURE_SEED_SOCIAL=0
