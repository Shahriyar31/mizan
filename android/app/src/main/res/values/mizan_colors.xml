<?xml version="1.0" encoding="utf-8"?>
<!-- Mizan brand colours mirrored from lib/core/theme/mizan_tokens.dart.
     Keep these two files in sync — Android needs the values at native
     resource level (splash + adaptive icon), before any Dart runs. -->
<resources>
    <!-- Light theme Page -->
    <color name="mizan_page_light">#FAF6EE</color>
    <!-- Dark theme Page -->
    <color name="mizan_page_dark">#0A2233</color>
    <!-- Adaptive-icon background. This is the Classic tile's own field colour,
         sampled from assets/logo/square/mizan_classic.png rather than taken
         from the palette — the launcher background must match the bitmap
         exactly, and the artwork's cream is #FDFAEC, a shade off the page's
         #FAF6EE. Regenerate both with tools/make_launcher_icons.py, which
         prints the colour it sampled.

         There is no second entry here any more. A cream/navy pair existed for
         an activity-alias that was never added to the manifest, so the alternate
         icon was unreachable; `launcherSwapSupported` in mizan_brand.dart is
         false and the App Icon screen says so plainly. -->
    <color name="ic_launcher_background">#FDFAEC</color>
</resources>
